################## Key bindings & zsh commands ##################

# Ctrl+J -> delete first word of current cmdline or hist, put the cursor at the beginning
function _change_command {
  zle beginning-of-line-hist
  zle delete-word
}
zle -N _change_command
bindkey "^J" _change_command

# Esc+h -> run-help with assistant functions for git, ip and sudo
autoload -Uz run-help run-help-git run-help-ip run-help-sudo
(( ${+aliases[run-help]} )) && unalias run-help

# Fancier `mv`:
# e.g.: zmv '(*)hell(*)' '${1}heaven${2}'
autoload zmv


# Load bash aliases
if [[ -r "${HOME}/.bash_aliases" ]]; then
  # ksh is closer than sh to bash
  emulate ksh -c "source '${HOME}/.bash_aliases'"
fi

# zellij helpers (taken from `zellij setup --generate-completion zsh`):
#   zr <cmd>   run <cmd> in a new pane    (zrf: floating, zri: in place)
#   ze <file>  open <file> in $EDITOR     (zef: floating, zei: in place)
function zr () { zellij run --name "$*" -- zsh -ic "$*";}
function zrf () { zellij run --name "$*" --floating -- zsh -ic "$*";}
function zri () { zellij run --name "$*" --in-place -- zsh -ic "$*";}
function ze () { zellij edit "$*";}
function zef () { zellij edit --floating "$*";}
function zei () { zellij edit --in-place "$*";}

# https://github.com/microsoft/vscode/issues/153400#issue-1286534600
if [[ "${TERM_PROGRAM}" == "vscode" ]]; then
  ITERM_SHELL_INTEGRATION_INSTALLED="Yes"
  # Helps with the following, but only in VS Code terminal
  # https://github.com/romkatv/powerlevel10k/blob/da9b03777c4f2390c7e3f5c720ee4689336f811b/README.md#horrific-mess-when-resizing-terminal-window
  POWERLEVEL9K_TERM_SHELL_INTEGRATION="true"
fi

# conda is initialized lazily on first use: its shell hook costs 350-750 ms,
# which would otherwise be paid by every new shell.
# Don't run `conda init zsh`, it would add the eager block again.
if [[ -x "${HOME}/repos/miniconda3/bin/conda" ]]; then
  conda() {
    unfunction conda
    eval "$("${HOME}/repos/miniconda3/bin/conda" shell.zsh hook)"
    conda "$@"
  }
fi

