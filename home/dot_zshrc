# Enable homebrew zsh completions
# (HOMEBREW_PREFIX is set by `brew shellenv` in .profile)
if [[ -n "${HOMEBREW_PREFIX}" ]]; then
  fpath+="${HOMEBREW_PREFIX}/share/zsh/site-functions"
fi

# Completions of tools that generate their own: cached as files in fpath, so
# zsh only autoloads them on the first <Tab> instead of eval'ing them on every
# start. A cached file is regenerated when the tool's binary is newer than it
# (i.e. after an update, however the tool was updated).
() {
  local dir="${XDG_CACHE_HOME:-${HOME}/.cache}/zsh/completions"
  # zellij appends helper functions (zr, ze, ...) after the completion; they
  # are defined further below instead, so strip them here
  local -A generators=(
    pixi   'pixi completion --shell zsh'
    uv     'uv generate-shell-completion zsh'
    typst  'typst completions zsh'
    zellij 'zellij setup --generate-completion zsh | sed "/^function zr /,\$d"'
    volta  'volta completions zsh'
    deno   'deno completions zsh'
    stern  'stern --completion zsh'
  )
  local tool bin file

  [[ -d "${dir}" ]] || mkdir -p "${dir}"
  for tool in ${(k)generators}; do
    bin="${commands[${tool}]}"
    file="${dir}/_${tool}"
    if [[ -z "${bin}" ]]; then
      rm -f "${file}"
    elif [[ ! -s "${file}" || "${bin}" -nt "${file}" ]]; then
      # write to a temp file first, so concurrently starting shells never
      # see a half-written completion
      if eval "${generators[${tool}]}" >|"${file}.tmp" 2>/dev/null; then
        mv -f "${file}.tmp" "${file}"
      else
        rm -f "${file}.tmp"
      fi
    fi
  done
  fpath=("${dir}" ${fpath})
}

